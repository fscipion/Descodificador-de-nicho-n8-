# ==============================================
# VARIABLES DE ENTORNO - DESCODIFICADOR DE NICHO
# ==============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env
# 2. Rellena TODAS las variables con tus valores reales
# 3. NO subas el archivo .env a git (está en .gitignore)
# 4. En n8n Cloud, configura estas variables en Settings > Variables
# 5. En n8n self-hosted, carga el .env en tu servidor

# ==============================================
# GOOGLE WORKSPACE
# ==============================================

# ID del Google Form que captura las entradas
# Lo encuentras en la URL: https://docs.google.com/forms/d/FORM_ID_AQUI/edit
GOOGLE_FORM_ID=1a2b3c4d5e6f7g8h9i0j

# ID del Google Sheet de seguimiento (Mini CRM)
# Lo encuentras en la URL: https://docs.google.com/spreadsheets/d/SHEET_ID_AQUI/edit
GOOGLE_SHEET_TRACKING_ID=1a2b3c4d5e6f7g8h9i0j_sheet_id

# ID del Google Doc template
# Lo encuentras en la URL: https://docs.google.com/document/d/DOC_ID_AQUI/edit
GOOGLE_DOC_TEMPLATE_ID=1a2b3c4d5e6f7g8h9i0j_doc_id

# ID de la carpeta de Google Drive donde archivar documentos completados
# Los documentos se guardan con nombre: "Descodificador de Nicho - email - YYYY-MM-DD"
# Lo encuentras en la URL de la carpeta: https://drive.google.com/drive/folders/FOLDER_ID_AQUI
# IMPORTANTE: Debe estar configurado para que la automatización funcione
GOOGLE_FOLDER_ID_ARCHIVE=1a2b3c4d5e6f7g8h9i0j_folder_id

# Carpeta de Google Drive donde guardar los PDFs generados (opcional)
# Si está vacío, se guardan en "My Drive"
GOOGLE_DRIVE_FOLDER_ID=

# ==============================================
# ANTHROPIC CLAUDE
# ==============================================

# API Key de Anthropic
# La obtienes en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de Claude a usar (recomendado: claude-3-5-sonnet-20241022)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Temperatura para las respuestas (0.0 = determinista, 1.0 = creativo)
# Recomendado: 0.7 para balance entre creatividad y consistencia
CLAUDE_TEMPERATURE=0.7

# Máximo de tokens en la respuesta
# Recomendado: 4000 para documentos completos
CLAUDE_MAX_TOKENS=4000

# ==============================================
# WHATSAPP BUSINESS API
# ==============================================

# Phone Number ID de WhatsApp Business
# Lo encuentras en Meta Business Suite > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Access Token de WhatsApp Business
# Lo generas en Meta Business Suite > System Users
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombres de las plantillas aprobadas en WhatsApp Business
# Debe estar APPROVED en Meta Business Suite
# IMPORTANTE: 3 plantillas aprobadas (SIN PARÁMETROS):
#
# 1. "esdecodificador" - Plantilla inicial (30 min después del email)
#    "¿🎁Has podido ver tu Descodificador de nicho (Cliente ideal + Misión + Diferenciadores)?"
#
# 2. "esdecodificador_r1" - Recordatorio 1 (4h después si no responde)
#    "¿Has visto mi último mensaje sobre tu Descodificador de Nicho?"
#
# 3. "esdecodificador_r2" - Recordatorio 2 (22h después si no responde)
#    "Soy Franck. Me encantaría hablar contigo sobre tu nicho y cómo puedes diferenciarte en el mercado. ¿Tienes 5 minutos?"
#
WHATSAPP_TEMPLATE_NAME=esdecodificador
WHATSAPP_TEMPLATE_REMINDER_1=esdecodificador_r1
WHATSAPP_TEMPLATE_REMINDER_2=esdecodificador_r2

# Version de la API de WhatsApp (recomendado: v18.0)
WHATSAPP_API_VERSION=v18.0

# Webhook Verify Token (elige un string aleatorio seguro)
# Lo usas al configurar webhooks en Meta Business Suite
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mi_token_secreto_verificacion_12345

# ==============================================
# CONFIGURACIÓN DE EMAILS
# ==============================================

# Email "From" para los correos enviados
# Debe ser el email de la cuenta de Gmail configurada en n8n
# IMPORTANTE: Configura hola@latransformateca.com en Gmail OAuth2 credentials
EMAIL_FROM=hola@latransformateca.com

# Email "Reply-To" para que las respuestas lleguen aquí
EMAIL_REPLY_TO=hola@latransformateca.com

# Emails CC (opcional, separados por coma)
EMAIL_CC=

# Emails BCC para tracking interno (opcional, separados por coma)
EMAIL_BCC=admin@latransformateca.com

# ==============================================
# CONFIGURACIÓN DEL WORKFLOW
# ==============================================

# Delay en horas antes de enviar mensaje de WhatsApp
# Por defecto: 24 horas
WHATSAPP_DELAY_HOURS=24

# Habilitar/deshabilitar el envío de WhatsApp (true/false)
# Útil para testing sin enviar mensajes reales
WHATSAPP_ENABLED=true

# Habilitar/deshabilitar el envío de email (true/false)
EMAIL_ENABLED=true

# Modo de prueba (true/false)
# En modo test, todos los emails van a TEST_EMAIL en vez del usuario
TEST_MODE=false
TEST_EMAIL=test@latransformateca.com

# ==============================================
# n8n CONFIGURATION
# ==============================================

# URL base de tu instancia de n8n (para webhooks)
# n8n Cloud: https://tu-instancia.app.n8n.cloud
# Self-hosted: https://n8n.tu-dominio.com
N8N_BASE_URL=https://tu-instancia.app.n8n.cloud

# Timezone para timestamps (formato IANA)
TIMEZONE=Europe/Madrid

# ==============================================
# OPCIONES AVANZADAS (OPCIONAL)
# ==============================================

# Límite de reintentos para APIs que fallan
API_RETRY_LIMIT=3

# Delay entre reintentos en segundos
API_RETRY_DELAY=5

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Habilitar analytics/tracking interno (true/false)
ANALYTICS_ENABLED=false

# ==============================================
# DESARROLLO Y DEBUG
# ==============================================

# Modo debug (true/false)
# Muestra logs adicionales en n8n
DEBUG_MODE=false

# Guardar respuestas de Claude en Google Drive (true/false)
# Útil para análisis posterior
SAVE_CLAUDE_RESPONSES=false

# Webhook URL para notificaciones (Slack, Discord, etc.)
# Deja vacío si no usas
NOTIFICATION_WEBHOOK_URL=

# ==============================================
# NOTAS IMPORTANTES
# ==============================================
#
# SEGURIDAD:
# - NUNCA subas este archivo con valores reales a git
# - Usa secrets management en producción
# - Rota las API keys regularmente
# - Limita los permisos de las cuentas de servicio
#
# n8n CLOUD:
# - No uses archivo .env, configura en Settings > Variables
# - Las variables se acceden como $env.VARIABLE_NAME
#
# n8n SELF-HOSTED:
# - Carga el .env en el servidor donde corre n8n
# - Reinicia n8n después de cambiar variables
# - Asegúrate de que n8n tiene permisos de lectura
#
# TESTING:
# - Empieza con TEST_MODE=true
# - Prueba cada nodo individualmente
# - Verifica logs en n8n para debugging
#
# PRODUCCIÓN:
# - Monitorea límites de APIs
# - Configura alertas para errores
# - Haz backups regulares del Google Sheet
# - Revisa compliance con GDPR/WhatsApp policies
#
# ==============================================
