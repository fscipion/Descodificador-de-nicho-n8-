      "parameters": {
        "jsCode": "// Separar los 3 outputs de Claude\nconst fullResponse = $input.item.json.content[0].text;\nconst outputs = fullResponse.split('###OUTPUT_SEPARATOR###');\n\n// Limpiar dobles saltos de línea\nconst limpiarSaltos = (texto) => {\n  return texto.replace(/\\n\\n+/g, '\\n').trim();\n};\n\nconst output1 = outputs[0] ? limpiarSaltos(outputs[0]) : '';\nconst output2 = outputs[1] ? limpiarSaltos(outputs[1]) : '';\nconst output3 = outputs[2] ? limpiarSaltos(outputs[2]) : '';\n\nreturn {\n  ...$input.item.json,\n  claude_output_1: output1,\n  claude_output_2: output2,\n  claude_output_3: output3\n};"
      },
