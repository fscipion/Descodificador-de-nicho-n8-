      "id": "7f14ada0-09ea-4477-8f57-d165a1e8bf03",
      "name": "Preparar Anthropic"
    },
    {
      "parameters": {
        "jsCode": "// Detectar país desde el código de teléfono internacional\nconst countryCodeMap = {\n  '1': 'Estados Unidos/Canadá',\n  '34': 'España',\n  '52': 'México',\n  '54': 'Argentina',\n  '55': 'Brasil',\n  '56': 'Chile',\n  '57': 'Colombia',\n  '58': 'Venezuela',\n  '351': 'Portugal',\n  '502': 'Guatemala',\n  '503': 'El Salvador',\n  '504': 'Honduras',\n  '505': 'Nicaragua',\n  '506': 'Costa Rica',\n  '507': 'Panamá',\n  '51': 'Perú',\n  '53': 'Cuba',\n  '593': 'Ecuador',\n  '595': 'Paraguay',\n  '598': 'Uruguay',\n  '591': 'Bolivia',\n  '33': 'Francia',\n  '39': 'Italia',\n  '44': 'Reino Unido',\n  '49': 'Alemania'\n};\n\nreturn items.map(item => {\n  const telefono = item.json['Teléfono (formato internacional +34...)'] || '';\n  let pais = 'Desconocido';\n  \n  if (telefono.startsWith('+')) {\n    const phoneNumber = telefono.substring(1);\n    for (let len = 3; len >= 1; len--) {\n      const code = phoneNumber.substring(0, len);\n      if (countryCodeMap[code]) {\n        pais = countryCodeMap[code];\n        break;\n      }\n    }\n  }\n  \n  return {\n    json: {\n      ...item.json,\n      'País': pais\n    }\n  };\n});"
      },
